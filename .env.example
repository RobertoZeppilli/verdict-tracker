# Public URL of the app, used for absolute links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: where the data file lives. Default `~/.verdict` (`%LOCALAPPDATA%\verdict` on Windows).
VERDICT_DATA_DIR=

# Set by `pnpm build:static` and by nobody else: it is which of the two builds this is, the app with
# its server or the public showcase, which is files alone (issue #215). Leave it unset here.
NEXT_PUBLIC_STATIC_SITE=

# Server-only: the model that writes the Summaries, any server with the chat completions of OpenAI.
# Without VERDICT_MODEL the Summaries stay pending. The URL defaults to Ollama on this computer;
# the key is only for a remote provider; the context (tokens) refuses notes that would not fit.
# Without it the app still runs, and a Release without its Summary says the key is missing. Never an Admin key (`sk-ant-admin...`).
VERDICT_MODEL_URL=http://localhost:11434/v1
VERDICT_MODEL=
VERDICT_MODEL_KEY=
VERDICT_MODEL_CONTEXT=

# Server-only, optional: raises GitHub's rate limit from 60 requests an hour for the Detection.
GITHUB_TOKEN=

# Server-only, optional: a Slack or Discord incoming webhook for `verdict-tracker sync --notify`
# (issue #218). It wins over the one saved in /settings; the app on a laptop does not need it.
VERDICT_WEBHOOK_URL=

# Optional: the folder of your Obsidian vault. The Releases of the Technologies you follow whose
# Summary asks for action are written as notes in <vault>/Verdict/ (issue #242).
# It wins over the folder saved in /settings (issue #244).
VERDICT_VAULT_DIR=

# Test-only: enables POST /api/test/revalidate and the page /test/throw, both of which the
# end-to-end tests need and nobody else does. At least 32 characters. Leave it unset in production:
# the route and the page answer 404.
E2E_AUTH_SECRET=
